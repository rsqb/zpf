# ────────────────────────────────────────────────────────────────────────

# ┌────────────────────────────────────────────────────────────────────────────┐
# │  Preconditions:                                                            │
# │    - realpath($0) == <project-root>/script/*                               │
# └────────────────────────────────────────────────────────────────────────────┘

# ═════ Initialization ═════════════════════════════════════════════════════════

# ───── Prologue ───────────────────────────────────────────────────────────────
set -euf

# Resolve script directory and <project-root>; cd to root
CDPATH= cd -- "$(dirname -- "$(realpath -- "$0")")"
readonly SCRIPT_DIR="$PWD"
cd ..
readonly PROJECT_ROOT="$PWD"

# ───── Constants ──────────────────────────────────────────────────────────────
# NOTE: keep in sync with script/console and script/clean
readonly TOOLS_DIR="$PROJECT_ROOT/tools"
readonly NIX_INSTALL_DIR="$TOOLS_DIR/nix"
readonly NP_BIN="$NIX_INSTALL_DIR/nix-portable"
readonly NP_LOCATION="$NIX_INSTALL_DIR"
readonly NP_HOME="$NP_LOCATION/.nix-portable"
readonly DISK_IMAGE="$NIX_INSTALL_DIR/nix-portable-ext4.img"
readonly MOUNT_POINT="$NP_HOME"

# NOTE: refactor if repository isn't on GitHub
readonly NP_REPO='DavHau/nix-portable'
readonly NP_RELEASE='latest'  # 'latest' or git tag, e.g. 'v012'
NP_ASSET="nix-portable-$(uname -m)"
readonly NP_ASSET

NP_URL="https://github.com/$NP_REPO/releases"
case $NP_RELEASE in
	latest) NP_URL="$NP_URL/latest/download" ;;
	*)      NP_URL="$NP_URL/download/$NP_RELEASE" ;;
esac
readonly NP_URL="$NP_URL/$NP_ASSET"

# ═════ Functions ══════════════════════════════════════════════════════════════

errx() {
	_exit_status=$1
	shift

	printf '%s: error' "${0##*/}" >&2
	if [ "$#" -gt 0 ]; then
		printf ': ' >&2
		printf "$@" >&2
	fi
	printf '\n' >&2

	exit "$_exit_status"
}

msg() {
	if [ "$#" -gt 0 ]; then
		printf '%s: ' "${0##*/}" >&2
		printf "$@" >&2
	fi
	printf '\n' >&2
}

# ═════ Main ═══════════════════════════════════════════════════════════════════

# nix-portable environment variables
export NP_LOCATION

# Download nix-portable if missing
if [ ! -s "$NP_BIN" ] || ! "$NP_BIN" nix --version >/dev/null 2>&1; then
	command -v curl >/dev/null || errx 1 'curl: not found'

	dir="${NP_BIN%/*}"
	msg "downloading nix-portable from %s to '%s'..." "$NP_URL" "$dir"
	mkdir -p "$dir"

	# Stage in temp file so nix-portable existence is atomic
	tmp=
	trap 'rm -f "$tmp"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 131' QUIT
	trap 'exit 143' TERM
	tmp="$(
		mktemp "$dir/.${NP_BIN##*/}.XXXXXX.part" 2>/dev/null ||
		    mktemp "$dir/.${NP_BIN##*/}.part.XXXXXX"  # no suffix on BSD
	)"
	unset -v dir

	curl --disable --proto '=https' --tlsv1.2 \
	    -fL --retry 3 --retry-connrefused \
	    --connect-timeout 10 --speed-limit 10 --speed-time 30 \
	    --progress-bar -o "$tmp" "$NP_URL"
	[ -s "$tmp" ] || errx 1 'downloaded file is empty'  # e.g. empty 200 OK

	chmod +x "$tmp"
	mv "$tmp" "$NP_BIN"

	trap - EXIT HUP INT QUIT TERM
	unset -v tmp
fi

exit 0

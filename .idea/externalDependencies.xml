<project version="4">
	<!-- TODO @rsqb: add plugin version constraints -->
	<component name="ExternalDependencies">
		<!-- ───── General ───────────────────────────────────────────────────────────────────── -->
		<!-- Used by Markdown & TODOs -->
		<plugin id="intellij.structureView.plugin"/>
		<!-- JSON language support; used by Mermaid -->
		<plugin id="com.intellij.modules.json"/>
		<!-- YAML language support; used by Mermaid -->
		<plugin id="org.jetbrains.plugins.yaml"/>
		<!-- TOML configuration language support -->
		<plugin id="org.toml.lang"/>
		<!-- Embedded browser; used by Markdown (images) -->
		<plugin id="com.intellij.modules.jcef"/>

		<!-- ───── VCS ───────────────────────────────────────────────────────────────────────── -->
		<!-- Git integration -->
		<plugin id="Git4Idea"/>
		<!-- .gitattributes syntax highlighting & completion -->
		<plugin id="com.github.xepozz.gitattributes"/>
		<!-- .gitignore/.dockerignore file support -->
		<plugin id="mobi.hsz.idea.gitignore"/>

		<!-- ───── Docs ──────────────────────────────────────────────────────────────────────── -->
		<!-- Markdown editor & preview; used by Mermaid -->
		<plugin id="org.intellij.plugins.markdown"/>
		<!-- Mermaid diagram rendering & syntax highlighting -->
		<plugin id="com.intellij.mermaid"/>

		<!-- ───── Workspace ─────────────────────────────────────────────────────────────────── -->
		<!-- .editorconfig file support & rule enforcement -->
		<plugin id="org.editorconfig.editorconfigjetbrains"/>
		<!-- TODOs comment tracking -->
		<plugin id="intellij.todo.plugin"/>
		<!-- IDE terminal (Nix dev workflow, Just recipes) -->
		<plugin id="org.jetbrains.plugins.terminal"/>
		<!-- Shell script syntax highlighting & completion -->
		<plugin id="com.jetbrains.sh"/>
		<!-- Nix language support -->
		<plugin id="nix-idea"/>
		<!-- Just command runner justfile support -->
		<plugin id="org.mvnsearch.plugins.justPlugin"/>
		<!-- NuShell syntax highlighting -->
		<plugin id="co.anbora.labs.nushell.community"/>

		<!-- ───── Source ────────────────────────────────────────────────────────────────────── -->
		<!-- Language server client; used by Zig -->
		<plugin id="com.redhat.devtools.lsp4ij"/>
		<!-- Zig language & tooling support -->
		<plugin id="com.falsepattern.zigbrains"/>
	</component>
</project>
